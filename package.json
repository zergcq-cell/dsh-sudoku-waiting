{
  "name": "dsh-sudoku-waiting",
  "version": "1.1.0",
  "description": "Resumable waiting games (Sudoku, 2048, Minesweeper, Lights Out) shown inline in the conversation while DeepSeek is thinking.",
  "type": "module",
  "license": "MIT",
  "author": "zergcq-cell (https://github.com/zergcq-cell)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zergcq-cell/dsh-sudoku-waiting.git"
  },
  "homepage": "https://github.com/zergcq-cell/dsh-sudoku-waiting#readme",
  "bugs": {
    "url": "https://github.com/zergcq-cell/dsh-sudoku-waiting/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "client-plugin",
    "sudoku",
    "2048",
    "minesweeper",
    "lights-out",
    "game",
    "games",
    "waiting",
    "idle"
  ],
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src/*.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "prepack": "node build.mjs",
    "publish:build": "node build-publish.mjs"
  }
}
